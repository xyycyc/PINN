# Local editor and generated tool environments.
.vscode/
.codex_tools/

# Local client delivery copy.
/jiaofu/

# Python caches and test/build by-products.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Runtime databases and generated data. Python import/build scripts under
# database/raw remain trackable through the explicit exceptions below.
database/data_process/
database/cache/
database/preprocess/
database/smoke_runtime/
database/rule/
database/raw/**
!database/raw/**/
!database/raw/**/*.py

# Training, prediction, benchmark, and audit outputs.
result/
audit/

# Model parameters and checkpoint weights.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5
*.pkl
*.joblib
*.bin
*.weights

# Generated numerical/tabular data.
*.npy
*.npz
*.csv

# Native compiler outputs; source files and build scripts remain tracked.
*.dll
*.mod
*.o
*.obj
*.exe
*.pyd
*.so
*.a
*.lib

# Runtime logs and temporary files.
*.log
*.tmp
*.temp

# Research audit: allow lightweight, derived statistics and reports only.
!research_audit/
!research_audit/**/*.md
!research_audit/**/*.json
!research_audit/**/*.csv
!research_audit/**/*.py
!research_audit/**/*.yaml
!research_audit/**/*.yml
!research_audit/**/*.png
