# Local editor and generated tool environments.
.vscode/
.codex_tools/

# Python caches and test/build by-products.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Runtime databases and generated data. Python import/build scripts under
# database/raw remain trackable through explicit exceptions.
database/data_process/
database/cache/
database/preprocess/
database/smoke_runtime/
database/rule/
database/raw/**
!database/raw/**/
!database/raw/**/*.py

# Training, prediction, benchmark, and audit outputs.
result/
audit/

# Model/checkpoint formats.
*.pt
*.pth
*.ckpt
*.onnx
*.safetensors
*.h5
*.hdf5
*.pkl
*.joblib
*.bin
*.weights

# Generated numerical/tabular files.
*.npy
*.npz
*.csv

# Native compiler outputs.
*.dll
*.mod
*.o
*.obj
*.exe
*.pyd
*.so
*.a
*.lib

# Logs and temporary files.
*.log
*.tmp
*.temp
